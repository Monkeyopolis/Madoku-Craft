{
  "schemaVersion": 1,
  "id": "madoku-craft-levels",
  "version": "${version}",
  "name": "Madoku Craft: Levels",
  "description": "A configurable player leveling system mod.",
  "authors": ["Monkeyopolis"],
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": ["madoku.craft.java.levels.MadokuLevelsInitializer"],
    "client": ["madoku.craft.java.levels.MadokuLevelsClientInitializer"]
  },
  "mixins": ["madoku-craft-levels.mixins.json"],
  "depends": {
    "fabricloader": "${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "${fabric_api_version}",
    "madoku-craft-core": "*"
  }
}
