{
  "schemaVersion": 1,
  "id": "madoku-craft-compat",
  "version": "${version}",
  "name": "Madoku Craft: Compat",
  "description": "An optional compatibility mod for Madoku Craft.",
  "authors": ["Monkeyopolis"],
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": ["madoku.craft.java.compat.MadokuCompatInitializer"],
    "client": ["madoku.craft.java.compat.MadokuCompatClientInitializer"]
  },
  "mixins": [
    "madoku-craft-compat.mixins.json",
    "madoku-craft.sodium.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "${fabric_api_version}",
    "madoku-craft-core": "*"
  },
  "suggests": {
    "madoku-craft-attributes": "*",
    "madoku-craft-levels": "*",
    "madoku-craft-farming": "*",
    "madoku-craft-mobs": "*",
    "madoku-craft-pets": "*",
    "madoku-craft-items": "*",
    "madoku-craft-hud": "*",
    "madoku-craft-utility": "*",
    "madoku-craft-ecosystem": "*",
    "sodium": "*",
    "iris": "*"
  }
}
